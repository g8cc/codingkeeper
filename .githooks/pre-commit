#!/bin/bash
# pre-commit 门禁 — 全量离线回归，与 AGENTS.md 的提交约定一致。
# 防止语法坏/单测红/契约漂移的代码进历史（v2.0 那次 run_runner 语法坏
# 直接进了 main，就是没有这道闸）。
#
# 启用: git config core.hooksPath .githooks
# 日常迭代可先跑 tests/run-all --profile quick；提交仍运行完整门禁。
set -u
root="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 1
exec "$root/tests/run-all" --profile full
